# ── InfluxDB Cloud ─────────────────────────────────────────────────────────────
# Créez un compte gratuit sur https://cloud2.influxdata.com
# Puis renseignez vos propres valeurs ci-dessous dans un fichier .env

INFLUXDB_URL=https://<region>.aws.cloud2.influxdata.com
INFLUXDB_TOKEN=<votre_token_api>
INFLUXDB_ORG=<votre_org_id>
INFLUXDB_BUCKET=pacte
